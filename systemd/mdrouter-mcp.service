[Unit]
Description=mdrouter MCP Server (Documentation + AI Agent Tools)
After=network-online.target mdrouter.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/mdrouter
ExecStart=/opt/mdrouter/.venv/bin/python -m mdrouter.mcp --transport streamable-http --host 127.0.0.1 --port 11436
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=%h/.local/share/mdrouter /opt/mdrouter/logs

# Performance
LimitNOFILE=8192
MemoryMax=512M

[Install]
WantedBy=multi-user.target
