[Unit]
Description=mdrouter MCP Server (User — Documentation + AI Agent Tools)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/mdrouter
ExecStart=%h/projects/mdrouter/.venv/bin/python -m mdrouter.mcp --transport streamable-http --host 127.0.0.1 --port 11436
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# Performance
LimitNOFILE=8192
MemoryMax=512M

[Install]
WantedBy=default.target
