{
  "enabled_capabilities": ["docs"],

  "db_path": "data/mcp.db",

  "transport": "stdio",
  "host": "127.0.0.1",
  "port": 11436,

  "summarization": {
    "enabled": true,
    "model": "deepseek/deepseek-v4-flash",
    "max_concurrent": 3,
    "max_tokens_per_day": 200000,
    "max_chunk_tokens": 4000,
    "prompt": "Summarize this documentation page into 3-5 key points. Focus on APIs, parameters, return types, and usage examples. Be concise — each point one sentence."
  },

  "scheduler": {
    "enabled": true,
    "default_interval_hours": 24,
    "jitter_seconds": 300
  },

  "capabilities": {
    "docs": {
      "user_agent": "mdrouter-docbot/1.0",
      "max_pages_per_site": 500,
      "max_concurrent_requests": 5,
      "request_delay_seconds": 0.5,
      "crawl_interval_hours": 24
    }
  }
}
