{
  "providers": {
    "deepseek": {
      "type": "openai_compat",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "wire_format": "openai_chat",
      "timeout": 90,
      "quirks": [
        "require_reasoning_content_for_thinking"
      ]
    }
  },
  "models": {
    "deepseek/deepseek-v4-flash": {
      "provider": "deepseek",
      "upstream_model": "deepseek-v4-flash",
      "capabilities": [
        "chat",
        "stream",
        "tools",
        "thinking"
      ],
      "context_length": 1000000,
      "extra": {
        "description": "DeepSeek V4 Flash - fast, cost-effective model with thinking mode support",
        "max_output": 384000
      }
    },
    "deepseek/deepseek-v4-pro": {
      "provider": "deepseek",
      "upstream_model": "deepseek-v4-pro",
      "capabilities": [
        "chat",
        "stream",
        "tools",
        "thinking"
      ],
      "context_length": 1000000,
      "extra": {
        "description": "DeepSeek V4 Pro - flagship model with thinking mode support",
        "max_output": 384000
      }
    }
  }
}
