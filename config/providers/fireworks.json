{
  "providers": {
    "fireworks": {
      "type": "openai_compat",
      "base_url": "https://api.fireworks.ai/inference/v1",
      "api_key_env": "FIREWORKS_API_KEY",
      "wire_format": "openai_chat",
      "timeout": 90,
      "quirks": ["no_prompt_cache"]
    }
  },
  "models": {
    "fireworks/kimi-k2p5": {
      "provider": "fireworks",
      "upstream_model": "accounts/fireworks/models/kimi-k2p5",
